            "value": "<script>\n(function () {\n  var PIXEL = '1011587088582742', ENDPOINT = 'https://padroes-api.vercel.app/api/e';\n  var ev = {{Event}}, ec = {{DLV - ecommerce}}, name, data = {};\n  if (ev === 'gtm.js') name = 'PageView';\n  else if (ev === 'view_item') name = 'ViewContent';\n  else if (ev === 'begin_checkout') name = 'CheckoutClick';\n  else if (ev === 'gtm.scrollDepth') { name = 'ScrollDepth'; data = { percent: {{Scroll Depth Threshold}} }; }\n  else return;\n  if (name !== 'ScrollDepth' && name !== 'PageView' && ec && ec.items) {\n    data = {\n      content_type: 'product',\n      content_ids: ec.items.map(function (i) { return i.item_id; }),\n      contents: ec.items.map(function (i) { return { id: i.item_id, quantity: 1, item_price: i.price }; }),\n      content_name: ec.items.map(function (i) { return i.item_name; }).join(' | '),\n      currency: 'BRL'\n    };\n    if (ec.value) data.value = ec.value;\n  }\n\n  function ck(n) { var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)'); return m ? decodeURIComponent(m[1]) : ''; }\n  var dom = /(^|\\.)aviradaenem\\.com\\.br$/.test(location.hostname) ? ';domain=.aviradaenem.com.br' : '';\n  function setck(n, v) { document.cookie = n + '=' + v + ';path=/;max-age=7776000;SameSite=Lax' + dom; }\n  function qs(k) { var m = location.search.match(new RegExp('[?&]' + k + '=([^&]+)')); return m ? decodeURIComponent(m[1]) : ''; }\n\n  // external_id próprio + _fbp/_fbc criados antes do Pixel, para o CAPI já sair com eles no 1º PageView.\n  var xid = ck('_xid') || (Date.now().toString(36) + Math.random().toString(36).slice(2));\n  setck('_xid', xid);\n  var fbp = ck('_fbp');\n  if (!fbp) { fbp = 'fb.1.' + Date.now() + '.' + Math.floor(Math.random() * 1e10); setck('_fbp', fbp); }\n  var fbc = ck('_fbc'), fbclid = qs('fbclid');\n  if (fbclid && (!fbc || fbc.split('.').slice(3).join('.') !== fbclid)) { fbc = 'fb.1.' + Date.now() + '.' + fbclid; setck('_fbc', fbc); }\n\n  if (!window.fbq) {\n    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,\n    document,'script','https://connect.facebook.net/en_US/fbevents.js');\n    fbq('init', PIXEL, { external_id: xid });\n  }\n\n  var id = name + '.' + Date.now() + '.' + Math.random().toString(36).slice(2, 8);\n  fbq(name === 'PageView' || name === 'ViewContent' ? 'track' : 'trackCustom', name, data, { eventID: id });\n\n  var body = JSON.stringify({\n    event_name: name, event_id: id, event_source_url: location.href, custom_data: data,\n    fbp: fbp, fbc: fbc, external_id: xid, test_event_code: qs('test_event_code')\n  });\n  if (navigator.sendBeacon) navigator.sendBeacon(ENDPOINT, body);\n  else fetch(ENDPOINT, { method: 'POST', body: body, keepalive: true, mode: 'no-cors' });\n})();\n</script>"
